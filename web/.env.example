# air frontend — copy to web/.env.local

# Google Maps. Without a key the map adapter automatically falls back to
# MapLibre with keyless CARTO styles, so the demo always renders.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Force a basemap backend: google | maplibre  (default: auto-detect from the key)
VITE_BASEMAP=
